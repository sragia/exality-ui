package-as: ExalityUI

externals:
  ExalityUI/Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
  ExalityUI/Libs/CallbackHandler-1.0:
    url: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  ExalityUI/Libs/LibQTip-1.0: https://repos.wowace.com/wow/libqtip-1-0
  ExalityUI/Libs/libdatabroker-1-1: https://github.com/tekkub/libdatabroker-1-1
  ExalityUI/Libs/LibSharedMedia-3.0:
    url: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  ExalityUI/Libs/LibDBIcon-1.0: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  ExalityUI/Libs/oUF:
    url: https://github.com/oUF-wow/oUF
    branch: aurapocalypse
    # tag: 13.4.5
  ExalityUI/ExalityFrames:
    url: https://github.com/sragia/ExalityFrames
